# jetopodvod.spaicestudio.cz na Railway. TLS končí na hraně Railway, kontejner mluví jen HTTP.
{
	auto_https off
	admin off
	persist_config off
}

:{$PORT} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; img-src 'self'; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	# Konfigurace a dokumentace z repa nejsou veřejné. Railway smazání v Dockerfile neprovede, proto 404 tady.
	@private path /Dockerfile /Caddyfile /railway.json /CNAME /.nojekyll /.gitignore /.dockerignore /README.md
	error @private 404

	# Síťový dotaz iOS filtru SMS (ILMessageFilterExtensionNetworkURL, sekce messagefilter v AASA).
	# Jde na Edge Function `sms-filter` na Railway; funkce přijme jen požadavek s tajemstvím proxy.
	# Tělo (text SMS, odesílatel) se nikde neloguje – Caddy tu nemá access log.
	handle /api/sms-filter {
		request_body {
			max_size 16KB
		}
		rewrite * /functions/v1/sms-filter
		reverse_proxy {$SMS_FILTER_UPSTREAM} {
			header_up Host {upstream_hostport}
			header_up x-proxy-secret {$SMS_FILTER_PROXY_SECRET}
			header_up -Cookie
			header_up -Authorization
			header_down Cache-Control "no-store"
		}
	}

	# Universal links a filtr SMS: iOS čte soubor bez přípony jen jako JSON
	@aasa path /.well-known/apple-app-site-association
	header @aasa Content-Type "application/json"

	# Odkazy z aplikace bez nainstalované aplikace (apps/mobile/src/features/links/rewrite.ts).
	# Adresa v prohlížeči zůstane, pozvánka si kód přečte z ní.
	@invite path /rodina/pozvanka/*
	rewrite @invite /pozvanka/index.html
	@applink path /vlna/* /lekce/* /hledat /sos
	rewrite @applink /odkaz/index.html

	@fonts path /assets/fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"
	@media path *.webp *.jpg *.jpeg *.png *.svg *.ico
	header @media Cache-Control "public, max-age=86400"
	@rest not path /assets/fonts/* *.webp *.jpg *.jpeg *.png *.svg *.ico
	header @rest Cache-Control "public, max-age=0, must-revalidate"

	file_server

	handle_errors {
		@404 expression `{err.status_code} == 404`
		handle @404 {
			header Cache-Control "no-store"
			rewrite * /404.html
			file_server
		}
	}
}
